{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^3.5.33",
    "@types/toastr": "^2.1.43",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "rimraf": "^6.1.3",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "typescript-lit-html-plugin": "^0.9.0"
  },
  "scripts": {
    "build": "rimraf dist && npm run build:ts && npm run build:scss",
    "watch": "concurrently \"npm run watch:ts\" \"npm run watch:scss\"",
    "lint": "eslint .",
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build:scss": "sass src/scss/base.scss dist/css/base.css",
    "watch:scss": "sass --watch src/scss/base.scss:dist/css/base.css"
  },
  "dependencies": {
    "lit": "^3.3.2",
    "toastr": "^2.1.4"
  }
}